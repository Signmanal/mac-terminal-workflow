# Zsh 配置示例
# 将此文件内容添加到你的 ~/.zshrc 中

# ============================================
# Oh My Zsh 配置
# ============================================

# Path to oh-my-zsh installation
export ZSH="$HOME/.oh-my-zsh"

# 主题设置
ZSH_THEME="robbyrussell"  # 或者使用 "agnoster", "powerlevel10k/powerlevel10k" 等

# 插件配置
plugins=(
  git
  zsh-autosuggestions
  zsh-syntax-highlighting
  z
  sudo
  extract
  colored-man-pages
)

source $ZSH/oh-my-zsh.sh

# ============================================
# Zoxide 配置（智能目录跳转）
# ============================================

# 初始化 zoxide
eval "$(zoxide init zsh)"

# 别名：用 z 替代 cd
alias cd="z"

# ============================================
# Yazi 配置（文件管理器）
# ============================================

# Yazi 快捷启动函数（退出后自动跳转到最后访问的目录）
function yy() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

# ============================================
# 常用别名
# ============================================

# 系统命令增强
alias ls="ls -G"  # macOS 彩色输出
alias ll="ls -lah"
alias la="ls -A"
alias l="ls -CF"

# 快捷命令
alias c="clear"
alias h="history"
alias ..="cd .."
alias ...="cd ../.."

# Git 快捷命令
alias gs="git status"
alias ga="git add"
alias gc="git commit"
alias gp="git push"
alias gl="git log --oneline --graph --decorate"

# 文件管理
alias f="yy"  # 快速启动 yazi

# ============================================
# 环境变量
# ============================================

# 编辑器
export EDITOR="nvim"
export VISUAL="nvim"

# 语言设置
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

# Homebrew（Apple Silicon Mac）
if [[ $(uname -m) == "arm64" ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ============================================
# 自定义函数
# ============================================

# 快速创建并进入目录
mkcd() {
  mkdir -p "$1" && cd "$1"
}

# 快速查找文件
ff() {
  find . -type f -name "*$1*"
}

# 快速查找目录
fd() {
  find . -type d -name "*$1*"
}

# ============================================
# 终端提示符优化（可选）
# ============================================

# 如果不使用 Oh My Zsh 主题，可以自定义提示符
# PROMPT='%F{cyan}%~%f %F{green}❯%f '
